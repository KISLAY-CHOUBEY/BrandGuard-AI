# ThroneCaptures - Environment Variables
# The Gemini API key is configured server-side in Vercel Project Settings.
# It is NEVER stored in the frontend or sent from the browser.
#
# For local development with `vercel dev`:
# 1. Set GEMINI_API_KEY in Vercel Dashboard → Project Settings → Environment Variables
# 2. Run `vercel env pull` to sync to .env.local (gitignored)
# 3. Run `vercel dev` to start both frontend and API proxy

GEMINI_API_KEY=your-gemini-api-key-here