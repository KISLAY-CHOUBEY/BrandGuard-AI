# Vercel ignore patterns
# Exclude secrets and local files
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Build outputs (Vercel builds its own)
dist/
build/

# Release artifacts
release/

# Logs
logs/
*.log

# Editor/IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Test coverage
coverage/

# TypeScript cache
*.tsbuildinfo

# Source maps (generated during build)
*.map

# Misc
*.tgz
.cache/